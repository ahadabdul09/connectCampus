# ==============================================================================
# connectCampus Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database configuration
# For PostgreSQL / Docker: postgresql://postgres:postgres@localhost:5432/connectcampus?schema=public
# For zero-dependency local dev: file:./dev.db
DATABASE_URL=file:./dev.db

# Redis configuration (Optional in local development - in-memory fallback enabled automatically)
# redis://localhost:6379
REDIS_URL=

# JWT Secrets for authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-connectcampus-2026
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-connectcampus-2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Campus AI / LLM Integration (Optional - intelligent campus heuristic fallback enabled)
# Supports Google Gemini API (gemini-1.5-flash / gemini-2.0-flash)
AI_API_KEY=
AI_PROVIDER=gemini

# File storage configuration
STORAGE_DRIVER=local
STORAGE_URL=http://localhost:5000/uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
