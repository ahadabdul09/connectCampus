datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// User & Authentication Models
// ==========================================
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  role           String    @default("STUDENT") // STUDENT, FACULTY, CLUB_COORDINATOR, DEPT_ADMIN, SUPER_ADMIN
  departmentId   String?
  batch          String?   // e.g. "2023-2027", "3rd Year"
  studentId      String?   @unique
  avatarUrl      String?
  bio            String?
  isOnline       Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  conversationMembers ConversationMember[]
  messages            Message[]
  messageReactions    MessageReaction[]
  channelMembers      ChannelMember[]
  clubMembers         ClubMember[]
  ledClubs            Club[]               @relation("ClubLead")
  announcements       Announcement[]       @relation("AuthorAnnouncements")
  organizedEvents     Event[]              @relation("OrganizedEvents")
  eventRegistrations  EventRegistration[]
  uploadedResources   Resource[]           @relation("UploaderResources")
  notifications       Notification[]
  filedReports        Report[]             @relation("UserReports")
  refreshTokens       RefreshToken[]
  aiConversations     AIConversation[]
  uploadedDocuments   Document[]
  sentInvitations     Invitation[]         @relation("SentInvitations")

  @@index([email])
  @@index([departmentId])
  @@index([role])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ==========================================
// Academic Department & Batch Models
// ==========================================
model Department {
  id               String         @id @default(uuid())
  name             String         @unique
  code             String         @unique
  description      String?
  headOfDepartment String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  users            User[]
  batches          Batch[]
  conversations    Conversation[]
  channels         Channel[]
  announcements    Announcement[]
  events           Event[]
  resources        Resource[]
  documents        Document[]
  invitations      Invitation[]

  @@index([code])
}

model Batch {
  id           String      @id @default(uuid())
  year         String
  name         String
  departmentId String
  createdAt    DateTime    @default(now())

  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ==========================================
// Real-time Chat & Direct Messaging Models
// ==========================================
model Conversation {
  id            String               @id @default(uuid())
  title         String?
  type          String               @default("DIRECT")
  departmentId  String?
  clubId        String?
  isArchived    Boolean              @default(false)
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  department    Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  club          Club?                @relation(fields: [clubId], references: [id], onDelete: SetNull)
  members       ConversationMember[]
  messages      Message[]

  @@index([type])
  @@index([departmentId])
  @@index([clubId])
  @@index([lastMessageAt])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  lastReadAt     DateTime     @default(now())
  isMuted        Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String            @default("TEXT")
  replyToId      String?
  isPinned       Boolean           @default(false)
  isEdited       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]         @relation("MessageReplies")
  reactions      MessageReaction[]
  attachments    Attachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Attachment {
  id         String    @id @default(uuid())
  messageId  String?
  resourceId String?
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  createdAt  DateTime  @default(now())

  message    Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([resourceId])
}

// ==========================================
// Department Channels
// ==========================================
model Channel {
  id           String          @id @default(uuid())
  name         String
  description  String?
  departmentId String
  isPrivate    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members      ChannelMember[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

// ==========================================
// Student Clubs & Communities
// ==========================================
model Club {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String         @unique
  description   String
  category      String         @default("TECHNICAL")
  leadId        String?
  bannerUrl     String?
  memberCount   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lead          User?          @relation("ClubLead", fields: [leadId], references: [id], onDelete: SetNull)
  members       ClubMember[]
  conversations Conversation[]
  events        Event[]
  resources     Resource[]

  @@index([category])
  @@index([code])
}

model ClubMember {
  id       String   @id @default(uuid())
  clubId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

// ==========================================
// Campus Announcements & Notices
// ==========================================
model Announcement {
  id            String      @id @default(uuid())
  title         String
  content       String
  priority      String      @default("NORMAL")
  departmentId  String?
  authorId      String
  attachmentUrl String?
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  author        User        @relation("AuthorAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([priority])
  @@index([createdAt])
}

// ==========================================
// Campus Events & Registrations
// ==========================================
model Event {
  id                   String              @id @default(uuid())
  title                String
  description          String
  organizerId          String
  departmentId         String?
  clubId               String?
  location             String
  eventDate            DateTime
  registrationDeadline DateTime?
  maxCapacity          Int                 @default(100)
  registeredCount      Int                 @default(0)
  bannerUrl            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organizer            User                @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  department           Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  club                 Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
  registrations        EventRegistration[]

  @@index([eventDate])
  @@index([departmentId])
  @@index([clubId])
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  userId       String
  status       String   @default("REGISTERED")
  registeredAt DateTime @default(now())

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ==========================================
// Academic & Campus Resource Library
// ==========================================
model Resource {
  id             String       @id @default(uuid())
  title          String
  description    String?
  category       String       @default("ACADEMICS")
  fileUrl        String
  fileType       String
  fileSize       Int
  departmentId   String?
  clubId         String?
  uploaderId     String
  downloadsCount Int          @default(0)
  tags           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  club           Club?        @relation(fields: [clubId], references: [id], onDelete: SetNull)
  uploader       User         @relation("UploaderResources", fields: [uploaderId], references: [id], onDelete: Cascade)
  attachments    Attachment[]

  @@index([category])
  @@index([departmentId])
  @@index([uploaderId])
  @@index([createdAt])
}

// ==========================================
// Notifications System
// ==========================================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("SYSTEM")
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ==========================================
// Moderation & Reporting System
// ==========================================
model Report {
  id          String   @id @default(uuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  status      String   @default("PENDING")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter    User     @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
}

// ==========================================
// AI Knowledge Assistant & RAG Storage
// ==========================================
model Document {
  id           String          @id @default(uuid())
  title        String
  category     String          @default("HANDBOOK")
  departmentId String?
  uploaderId   String
  chunkCount   Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploader     User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([category])
  @@index([departmentId])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String
  embedding  String?
  metadata   String?
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AIConversation {
  id          String   @id @default(uuid())
  userId      String
  query       String
  response    String
  contextUsed String?
  latencyMs   Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// Administrative Invitations
// ==========================================
model Invitation {
  id           String      @id @default(uuid())
  email        String      @unique
  role         String      @default("STUDENT")
  departmentId String?
  token        String      @unique
  expiresAt    DateTime
  invitedById  String
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())

  invitedBy    User        @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([email])
}

