{
  "name": "connectcampus-server",
  "version": "1.0.0",
  "description": "connectCampus backend API & real-time WebSocket server",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "bootstrap:admin": "node prisma/bootstrapAdmin.js",
    "seed:demo": "node prisma/seedDemo.js",
    "seed": "node prisma/seedDemo.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.6"
  }
}
